  "steps": [
    {
      "step_number": 1,
      "title": "Gewürzbasis pürieren",
      "instruction": "Alle Teigzutaten außer dem Seitan-Pulver (Wasser, Zwiebeln, Knoblauch, Piment, Zimt, Kardamom, Öl) fein pürieren.",
      "duration_minutes": 5,
      "temperature_celsius": null
    },
    {
      "step_number": 2,
      "title": "Teig anrühren und ruhen lassen",
      "instruction": "Die pürierte Mischung mit dem Seitan-Pulver verrühren (nicht zu lange kneten) und etwas ruhen bzw. gehen lassen.",
      "duration_minutes": 10,
      "temperature_celsius": null
    },
    {
      "step_number": 3,
      "title": "Formen und schneiden",
      "instruction": "Den Teig flach drücken oder ausrollen und in ca. 5 mm dicke Scheiben schneiden.",
      "duration_minutes": 5,
      "temperature_celsius": null
    },
    {
      "step_number": 4,
      "title": "Wenden und backen",
      "instruction": "Die Scheiben in einer Schüssel in Öl und Sojasauce wenden und bei 200 °C ca. 15 Minuten im Ofen backen, dabei zwischendurch wenden.",
      "duration_minutes": 10,
      "temperature_celsius": 200
    },
    {
      "step_number": 5,
      "title": "Glasieren",
      "instruction": "Ahornsirup, Stärke, Zucker, Sriracha, Sojasauce und etwas Wasser verrühren, 5 Minuten vor Ende der Backzeit auf den Scheiben verteilen und fertig backen.",
      "duration_minutes": 5,
      "temperature_celsius": 200
    }
